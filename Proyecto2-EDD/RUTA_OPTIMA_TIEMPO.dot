digraph RutaOptima {
    node [shape=circle, style=filled, fillcolor=lightblue];
    graph [rankdir=LR];
    "P1" [label="P1"];
    "P2" [label="P2"];
    "P3" [label="P3"];
    "P4" [label="P4"];
    "P5" [label="P5"];
    "P1" -> "P2" [label="T:10 C:10", color="gray"];
    "P2" -> "P3" [label="T:10 C:10", color="gray"];
    "P3" -> "P4" [label="T:10 C:10", color="gray"];
    "P3" -> "P5" [label="T:1 C:1", color="gray"];
    "P4" -> "P5" [label="T:10 C:10", color="gray"];
    "P5" -> "P1" [label="T:10 C:10", color="gray"];
    "P1" -> "P2" [color="red", penwidth=3.0, label="RUTA"];
    "P2" -> "P3" [color="red", penwidth=3.0, label="RUTA"];
    "P3" -> "P5" [color="red", penwidth=3.0, label="RUTA"];
    "P1" [fillcolor=lightgreen, style=filled];
    "P2" [fillcolor=lightgreen, style=filled];
    "P3" [fillcolor=lightgreen, style=filled];
    "P5" [fillcolor=lightgreen, style=filled];
    labelloc="t";
    label="RUTA OPTIMA POR TIEMPO | TOTAL: 21";
}
